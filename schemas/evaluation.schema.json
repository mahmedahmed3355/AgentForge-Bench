{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentforge.dev/schemas/evaluation.schema.json",
  "title": "AgentForge Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episodes",
    "episode_count",
    "total_reward",
    "verification_results"
  ],
  "properties": {
    "episodes": {
      "type": "array",
      "items": {
        "$ref": "episode.schema.json"
      }
    },
    "episode_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_reward": {
      "type": "number"
    },
    "verification_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verification_result"
      }
    }
  },
  "$defs": {
    "verification_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified",
        "verifier_id",
        "task_id",
        "episode",
        "trajectory",
        "reward",
        "success",
        "diagnostics",
        "metadata"
      ],
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "verifier_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "episode": {},
        "trajectory": {},
        "reward": {},
        "success": {},
        "diagnostics": {},
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
